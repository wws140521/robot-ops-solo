# Supabase 配置（可选，不填走本地 mock）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 默认租户 ID
VITE_DEFAULT_TENANT=default

# 工业扩展配置
VITE_AI_SAAS_URL=              # AI SaaS 项目地址（留空走 mock）
VITE_MQTT_BROKER_URL=          # MQTT broker 地址（留空走 WebSocket mock）
VITE_DEFAULT_INDUSTRIAL_BRAND=fanuc  # 默认工业品牌（开发用）

# 室外地图配置（可选，留空 /fleet-map 页面地图不加载）
VITE_AMAP_JS_KEY=              # 高德 JS API Key
VITE_AMAP_SECURITY_CODE=       # 高德 securityJsCode（JS API 安全密钥）
VITE_AMAP_WEB_KEY=             # 高德 Web 服务 Key（路径规划/地理编码 REST）

# Agent 配置
VITE_AGENT_MODE=enabled        # enabled/disabled；disabled 时走本地 mock 回复
VITE_OPENAI_API_KEY=           # OpenAI API Key（可选，未配置走 mock）
VITE_ANTHROPIC_API_KEY=        # Anthropic API Key（可选，未配置走 mock）
VITE_WECHAT_WORK_WEBHOOK=      # 企业微信机器人 webhook（可选）
VITE_DINGTALK_WEBHOOK=         # 钉钉机器人 webhook（可选）
