<?xml version="1.0"?>
<!-- FANUC M-20iA 官方模型：STL 和关节参数来自 ros-industrial/fanuc (fanuc_m20ia_support) -->
<!-- Z-up 米制，加载时需要 convertToYUp -->
<robot name="fanuc_m20ia">

  <material name="fanuc_yellow"><color rgba="0.96 0.76 0.13 1.0"/></material>
  <material name="fanuc_gray28"><color rgba="0.278 0.278 0.278 1.0"/></material>
  <material name="fanuc_black"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://fanuc_support/meshes/base_link.stl"/></geometry>
      <material name="fanuc_gray28"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://fanuc_support/meshes/link_1.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://fanuc_support/meshes/link_2.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
  </link>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://fanuc_support/meshes/link_3.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
  </link>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://fanuc_support/meshes/link_4.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
  </link>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://fanuc_support/meshes/link_5.stl"/></geometry>
      <material name="fanuc_yellow"/>
    </visual>
  </link>

  <link name="link_6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://fanuc_support/meshes/link_6.stl"/></geometry>
      <material name="fanuc_black"/>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.525" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967060" upper="2.967060" effort="100" velocity="3.403392"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <origin xyz="0.150 0 0" rpy="0 0 0"/>
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.745329" upper="2.792527" effort="100" velocity="3.054326"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <origin xyz="0 0 0.790" rpy="0 0 0"/>
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.228859" upper="4.766843" effort="100" velocity="3.141593"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <origin xyz="0 0 0.250" rpy="0 0 0"/>
    <parent link="link_3"/>
    <child link="link_4"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.490658" upper="3.490658" effort="50" velocity="6.283185"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <origin xyz="0.835 0 0" rpy="0 0 0"/>
    <parent link="link_4"/>
    <child link="link_5"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.443461" upper="2.443461" effort="50" velocity="6.283185"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <origin xyz="0.100 0 0" rpy="0 0 0"/>
    <parent link="link_5"/>
    <child link="link_6"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-4.712389" upper="4.712389" effort="30" velocity="9.599311"/>
  </joint>

</robot>
