<?xml version="1.0"?>
<!-- KUKA KR 6 R900 sixx 官方模型：STL 由 ros-industrial/kuka_experimental 的 DAE 转换而来 -->
<!-- 关节参数来自 kuka_kr6_support/urdf/kr6r900sixx_macro.xacro，Z-up 米制，加载时需要 convertToYUp -->
<robot name="kuka_kr6r900sixx">

  <material name="kuka_orange"><color rgba="0.965 0.471 0.157 1.0"/></material>
  <material name="kuka_pedestal"><color rgba="0.506 0.471 0.388 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://kuka_kr10_support/meshes/base_link.stl"/></geometry>
      <material name="kuka_pedestal"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://kuka_kr10_support/meshes/link_1.stl"/></geometry>
      <material name="kuka_orange"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://kuka_kr10_support/meshes/link_2.stl"/></geometry>
      <material name="kuka_orange"/>
    </visual>
  </link>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://kuka_kr10_support/meshes/link_3.stl"/></geometry>
      <material name="kuka_orange"/>
    </visual>
  </link>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://kuka_kr10_support/meshes/link_4.stl"/></geometry>
      <material name="kuka_orange"/>
    </visual>
  </link>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://kuka_kr10_support/meshes/link_5.stl"/></geometry>
      <material name="kuka_orange"/>
    </visual>
  </link>

  <link name="link_6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://kuka_kr10_support/meshes/link_6.stl"/></geometry>
      <material name="kuka_pedestal"/>
    </visual>
  </link>

  <joint name="joint_a1" type="revolute">
    <origin xyz="0 0 0.400" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.967060" upper="2.967060" effort="100" velocity="6.283185"/>
  </joint>

  <joint name="joint_a2" type="revolute">
    <origin xyz="0.025 0 0" rpy="0 0 0"/>
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.316126" upper="0.785398" effort="100" velocity="5.235988"/>
  </joint>

  <joint name="joint_a3" type="revolute">
    <origin xyz="0.455 0 0" rpy="0 0 0"/>
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395" upper="2.722714" effort="100" velocity="6.283185"/>
  </joint>

  <joint name="joint_a4" type="revolute">
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <parent link="link_3"/>
    <child link="link_4"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.228859" upper="3.228859" effort="50" velocity="6.651684"/>
  </joint>

  <joint name="joint_a5" type="revolute">
    <origin xyz="0.420 0 0" rpy="0 0 0"/>
    <parent link="link_4"/>
    <child link="link_5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395" upper="2.094395" effort="50" velocity="6.773870"/>
  </joint>

  <joint name="joint_a6" type="revolute">
    <origin xyz="0.080 0 0" rpy="0 0 0"/>
    <parent link="link_5"/>
    <child link="link_6"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.108652" upper="6.108652" effort="30" velocity="10.733775"/>
  </joint>

</robot>
