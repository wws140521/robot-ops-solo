<?xml version="1.0"?>
<!-- ESTUN iER7-910-MI 官方模型：STL 由 ESTUN-R-D/estun_description 的 DAE 转换并减面而来 -->
<!-- 关节参数来自 iER7-910-MI-macro.xacro + default_kinematics.yaml（L1=391 L2=40 L3=430 L4=40 L5=445 L6=80） -->
<!-- Z-up 米制，加载时需要 convertToYUp -->
<robot name="estun_ier7_910_mi">

  <material name="estun_white"><color rgba="0.92 0.92 0.94 1.0"/></material>
  <material name="estun_gray"><color rgba="0.55 0.57 0.60 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://estun_support/meshes/base_link.stl"/></geometry>
      <material name="estun_white"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://estun_support/meshes/link1.stl"/></geometry>
      <material name="estun_white"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://estun_support/meshes/link2.stl"/></geometry>
      <material name="estun_white"/>
    </visual>
  </link>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://estun_support/meshes/link3.stl"/></geometry>
      <material name="estun_gray"/>
    </visual>
  </link>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://estun_support/meshes/link4.stl"/></geometry>
      <material name="estun_white"/>
    </visual>
  </link>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://estun_support/meshes/link5.stl"/></geometry>
      <material name="estun_gray"/>
    </visual>
  </link>

  <link name="link_6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://estun_support/meshes/link6.stl"/></geometry>
      <material name="estun_gray"/>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.391" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.967060" upper="2.967060" effort="500" velocity="5.846853"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <origin xyz="0.040 0 0" rpy="0 0 0"/>
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.396263" upper="2.356194" effort="450" velocity="5.759587"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <origin xyz="0 0 0.430" rpy="0 0 0"/>
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.316126" upper="1.134464" effort="200" velocity="7.068583"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <origin xyz="0 0 0.040" rpy="0 1.570796327 0"/>
    <parent link="link_3"/>
    <child link="link_4"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.316126" upper="3.316126" effort="50" velocity="8.726646"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <origin xyz="0 0 0.445" rpy="0 0 0"/>
    <parent link="link_4"/>
    <child link="link_5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395" upper="2.094395" effort="50" velocity="7.853982"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link_5"/>
    <child link="link_6"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-6.283185" upper="6.283185" effort="50" velocity="12.304571"/>
  </joint>

</robot>
