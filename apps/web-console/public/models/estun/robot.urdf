<?xml version="1.0"?>
<robot name="estun_er6">

  <material name="estun_yellow">
    <color rgba="1.0 0.82 0.0 1.0"/>
  </material>
  <material name="estun_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- base link -->
  <link name="base">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1225"/>
      <geometry>
        <mesh filename="package://estun_support/meshes/base_link.STL"/>
      </geometry>
      <material name="estun_dark"/>
    </visual>
  </link>

  <link name="j1">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.07"/>
      <geometry>
        <mesh filename="package://estun_support/meshes/j1_link.STL"/>
      </geometry>
      <material name="estun_yellow"/>
    </visual>
  </link>

  <link name="j2">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.14"/>
      <geometry>
        <mesh filename="package://estun_support/meshes/j2_link.STL"/>
      </geometry>
      <material name="estun_yellow"/>
    </visual>
  </link>

  <link name="j3">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10"/>
      <geometry>
        <mesh filename="package://estun_support/meshes/j3_link.STL"/>
      </geometry>
      <material name="estun_yellow"/>
    </visual>
  </link>

  <link name="j4">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.045"/>
      <geometry>
        <mesh filename="package://estun_support/meshes/j4_link.STL"/>
      </geometry>
      <material name="estun_yellow"/>
    </visual>
  </link>

  <link name="j5">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.04"/>
      <geometry>
        <mesh filename="package://estun_support/meshes/j5_link.STL"/>
      </geometry>
      <material name="estun_yellow"/>
    </visual>
  </link>

  <link name="j6">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://estun_support/meshes/j6_link.STL"/>
      </geometry>
      <material name="estun_yellow"/>
    </visual>
  </link>

  <!-- base -> j1 绕Y轴 -->
  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.245" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="j1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.967059728" upper="2.967059728" effort="100" velocity="3.14"/>
  </joint>

  <!-- j1 -> j2 绕X轴 -->
  <joint name="joint_2" type="revolute">
    <origin xyz="0 0 -0.14" rpy="0 0 0"/>
    <parent link="j1"/>
    <child link="j2"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.570796327" upper="2.617993878" effort="100" velocity="2.094"/>
  </joint>

  <!-- j2 -> j3 绕X轴 -->
  <joint name="joint_3" type="revolute">
    <origin xyz="0 0 -0.28" rpy="0 0 0"/>
    <parent link="j2"/>
    <child link="j3"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.617993878" upper="1.570796327" effort="100" velocity="2.094"/>
  </joint>

  <!-- j3 -> j4 绕X轴 -->
  <joint name="joint_4" type="revolute">
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    <parent link="j3"/>
    <child link="j4"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.839724354" upper="3.839724354" effort="50" velocity="4.189"/>
  </joint>

  <!-- j4 -> j5 绕Y轴 -->
  <joint name="joint_5" type="revolute">
    <origin xyz="0 0 -0.09" rpy="0 0 0"/>
    <parent link="j4"/>
    <child link="j5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.443460953" upper="2.443460953" effort="50" velocity="3.141"/>
  </joint>

  <!-- j5 -> j6 绕X轴 -->
  <joint name="joint_6" type="revolute">
    <origin xyz="0 0 -0.08" rpy="0 0 0"/>
    <parent link="j5"/>
    <child link="j6"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="30" velocity="6.283"/>
  </joint>

</robot>
